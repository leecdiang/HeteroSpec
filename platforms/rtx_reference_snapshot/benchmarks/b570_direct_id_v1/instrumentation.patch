--- /dev/null
+++ b/common/heterospec-direct-id.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+// Observational only: no runtime/sampler/KV operations, file I/O after generation.
+struct heterospec_direct_ids {
+    std::vector<int> ids;
+    std::vector<bool> eog;
+    heterospec_direct_ids() { ids.reserve(4096); eog.reserve(4096); }
+    void commit(int id, bool is_eog) { ids.push_back(id); eog.push_back(is_eog); }
+    bool write() const {
+        const char * path = std::getenv("HETEROSPEC_DIRECT_ID_PATH");
+        if (!path) { return true; }
+        FILE * f = std::fopen(path, "wb");
+        if (!f) { return false; }
+        std::fprintf(f, "{\"schema\":\"heterospec.direct_committed_ids.v1\",\"ids\":[");
+        for (size_t i = 0; i < ids.size(); ++i) { std::fprintf(f, "%s%d", i ? "," : "", ids[i]); }
+        std::fprintf(f, "],\"eog\":[");
+        for (size_t i = 0; i < eog.size(); ++i) { std::fprintf(f, "%s%s", i ? "," : "", eog[i] ? "true" : "false"); }
+        std::fprintf(f, "]}\n");
+        return std::fclose(f) == 0;
+    }
+};
