{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeteroSpec-PC run record",
  "type": "object",
  "required": ["run_id", "experiment", "config", "valid"],
  "properties": {
    "run_id": {"type": "string"},
    "experiment": {"type": "string"},
    "config": {"type": "string"},
    "git_commit": {"type": ["string", "null"]},
    "valid": {"type": "boolean"},
    "invalid_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
