--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ speculative accept path @@
+// Preserve target probabilities for each accepted speculative token before
+// spec_i_batch is cleared. populate_token_probs reads the target-context output
+// at the exact batched index used by common_sampler_sample_and_accept_n.
+std::vector<completion_token_output> accepted_probs;
+for (size_t i = 0; i < accepted.size(); ++i) {
+    completion_token_output prob;
+    prob.tok = accepted[i];
+    prob.prob = 1.0f;
+    populate_token_probs(slot, prob, false, params_base.special, slot.spec_i_batch[i]);
+    accepted_probs.push_back(std::move(prob));
+}
@@ response construction @@
+result.prob  = accepted_probs[i].prob;
+result.probs = std::move(accepted_probs[i].probs);
--- a/ggml/src/CMakeLists.txt
+++ b/ggml/src/CMakeLists.txt
@@ diagnostic static host @@
-message(FATAL_ERROR "GGML_BACKEND_DL requires BUILD_SHARED_LIBS")
+message(WARNING "HeteroSpec diagnostic: loading a frozen external backend from a static debug host")
